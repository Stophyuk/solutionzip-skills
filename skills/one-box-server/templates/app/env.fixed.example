# deploy/env.fixed — the first piece of /srv/<app>/.env (ops/env-merge.sh). Fixed values only: this file is committed.
# Secrets are made on the box (.env.generated) or pushed from your machine (.env.pushed), never written here.
COMPOSE_PROJECT_NAME=app1
NEXT_PUBLIC_SUPABASE_URL=https://api.app1.example.com
SUPABASE_PUBLIC_URL=https://api.app1.example.com
JWT_EXPIRY=3600
