{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push.mjs",
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(git -C * push *)",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push.mjs",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
